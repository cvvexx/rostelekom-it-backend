# Postgres для user-service
USERS_DB_HOST=localhost
USERS_DB_PORT=55432
USERS_DB_NAME=users
USERS_DB_USER=user
USERS_DB_PASSWORD=12341234

BILLINGS_DB_HOST=localhost
BILLINGS_DB_PORT=55433
BILLINGS_DB_NAME=billings
BILLINGS_DB_PASSWORD=12341234
BILLINGS_DB_USER=user


# Redis (хранит OTP-коды)
REDIS_HOST=localhost
REDIS_PORT=6379

# Выпуск JWT в user-service. Пусто => временный ключ генерируется на старте (только для dev).
# Для стабильных токенов между рестартами:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt-private.pem
#   JWT_PRIVATE_KEY_LOCATION=file:./jwt-private.pem
JWT_ISSUER=http://localhost:8081
JWT_AUDIENCE=rostelekom
JWT_PRIVATE_KEY_LOCATION=

# true => код из SMS возвращается прямо в ответе на /api/auth/otp/request.
# Поставить false, когда появится реальный SMS-провайдер
OTP_EXPOSE_CODE=true
